cabal-version: 2.4
name: uncertain-gantt
version: 0.0.0.0
synopsis: See README for more info
description:
  See README for more info.
  See README.md for more details.

license: NONE
author: Gustavo Bicalho
maintainer: Gustavo Bicalho <gusbicalho@gmail.com>
copyright: 2021 Gustavo Bicalho
category: Application
build-type: Simple
extra-doc-files:
  CHANGELOG.md
  README.md

tested-with: ghc ==9.8.2

common common-options
  build-depends: base >=4.19
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -Wnoncanonical-monad-instances
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies
    -fwrite-ide-info
    -hiedir=.hie
    -Wunused-packages

  default-language: GHC2021

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    UncertainGantt
    UncertainGantt.Lang.Parser
    UncertainGantt.Lang.Render
    UncertainGantt.Lang.Types
    UncertainGantt.Script.Parser
    UncertainGantt.Script.Render
    UncertainGantt.Script.Types
    UncertainGantt.Sim.Duration
    UncertainGantt.Sim.Estimate
    UncertainGantt.Project.Tolerant
    UncertainGantt.Sim.Stats
    UncertainGantt.Toml
    UncertainGantt.ToText
  other-modules:
    UncertainGantt.Gantt
    UncertainGantt.Project
    UncertainGantt.Script.StatementInterpreter
    UncertainGantt.Script.InterpreterState
    UncertainGantt.Script.ConsoleInterpreter
    UncertainGantt.Script.Runner
    UncertainGantt.Simulator
    UncertainGantt.Task

  build-depends:
    containers,
    megaparsec,
    monad-bayes,
    mtl,
    streaming,
    symbolize,
    text,
    tomland,
    transformers,

executable uncertain-gantt
  import: common-options
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    uncertain-gantt,
    text
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

executable uncertain-gantt-tui
  import: common-options
  hs-source-dirs: editor, tui
  main-is: Main.hs
  other-modules:
    Editor.Doc
    Editor.Estimate
    Editor.FormField
    Editor.Persistence
    Editor.View
    Tui.EstimateRender
    Tui.Widgets
  build-depends:
    containers,
    directory,
    filepath,
    reflex,
    reflex-vty,
    text,
    uncertain-gantt,
    vty
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

executable uncertain-gantt-web
  import: common-options
  hs-source-dirs: editor, web
  main-is: Main.hs
  other-modules:
    Editor.Doc
    Editor.Estimate
    Editor.FormField
    Editor.Persistence
    Editor.View
    Web.App
  build-depends:
    bytestring,
    containers,
    directory,
    effectful,
    filepath,
    hyperbole ==0.7.*,
    optparse-applicative,
    text,
    uncertain-gantt
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

test-suite uncertain-gantt-test
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    containers,
    text,
    uncertain-gantt
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
